# Browser-visible Supabase project details. These values are public by design.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Netlify Functions only. Never add service-role or Google client secrets to VITE_ variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google OAuth web client. Use the same OAuth client for Supabase sign-in and Gmail connect.
GMAIL_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GMAIL_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Generate three distinct random secrets (at least 32 characters each).
GMAIL_STATE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GMAIL_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WORKER_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Netlify sets URL in deployed functions. Set this for local functions if needed.
# URL=http://localhost:8888
